# ==============================
# ⚡  PowerShell-specific
# ==============================

# PowerShell cache/working directories
PSScriptRoot/

# Backup files (often auto-generated by editors like VSCode)
*.ps1.bak
*.bak.ps1

# Debugging and transcript logs
*.log
*.out
*.err
*.ps1.xml
*.ps1.debug.log
*.transcript.txt

# Editor-specific PowerShell workspace files
*.code-workspace

# VSCode PowerShell Editor Services files
.vscode-test/
.vscode/

# Module packaging outputs (if building/distributing PowerShell modules)
*.nupkg
*.nuspec
*.snupkg

# Temporary files or export outputs
*.tmp
*.temp
*.backup

# Secret/credentials files (if accidentally exported in dev/test)
*.creds
*.secrets
*.key
*.pem
*.pfx
*.cert
*.env

# ==============================
# 🛠️  Compilation & Binaries
# ==============================

# Binary files (compiled)
bin/
obj/
*.o
*.so
*.a
*.la
*.lo
*.dylib
*.exe
*.dll
*.com

# Results for `make`
Makefile~
*.d

# ==============================
# 📝  Text editors
# ==============================

# Vim
*.swp
*.swo
*.swn
*.viminfo

# Nano
.nanorc
*.save

# VSCode
.vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# JetBrains (PyCharm, IntelliJ, WebStorm)
.idea/
*.iml

# Emacs
*~
*.spacemacs

# ==============================
# 💾  Operating systems
# ==============================

# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100/
.Trashes/
._*
__MACOSX/

